{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "TrackFlow API (local dev)",
			"type": "shell",
			"command": "SUPABASE_DATABASE_URL='' INVENTORY_DATABASE_URL=sqlite:///./data/trackflow_inventory.db .venv/bin/python -m uvicorn services.api.main:app --host 0.0.0.0 --port 8000",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "TrackFlow Backoffice (local dev)",
			"type": "shell",
			"command": "cd uis/application && npm run dev -- --hostname 0.0.0.0",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "TrackFlow local smoke check",
			"type": "shell",
			"command": "curl -sS -o /dev/null -w 'health HTTP %{http_code}\\n' http://127.0.0.1:8000/health && curl -sS -o /dev/null -w 'application HTTP %{http_code}\\n' http://127.0.0.1:3000/login",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "TrackFlow application typecheck",
			"type": "shell",
			"command": "cd uis/application && npm run typecheck",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "TrackFlow application build",
			"type": "shell",
			"command": "cd uis/application && npm run build",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}