# ──────────────────────────────────────────────
# TrackFlow — Talent Pipeline Tracker
# Variables de entorno
# ──────────────────────────────────────────────
#
# NEXT_PUBLIC_API_URL
#   URL base de la API REST del tracker de candidaturas.
#   Es una API mock compartida, desplegada por 4Geeks Academy.
#   Todos los endpoints (records, notes, etc.) cuelgan de esta raíz.
#
#   Valor por defecto (desarrollo):
#   https://playground.4geeks.com/tracker/api/v1
#
#   Para usar un entorno diferente, cambia esta URL
#   (ej. http://localhost:8000/api/v1 para desarrollo local).
#
NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1