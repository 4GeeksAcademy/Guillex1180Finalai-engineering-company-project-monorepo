# Local-only settings for docker compose. Copy this file to .env before startup.
# Generate a fresh value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Leave blank to use the persistent local SQLite database in trackflow_data.
SUPABASE_DATABASE_URL=
INVENTORY_DATABASE_URL=sqlite:////data/trackflow_inventory.db
TINYDB_PATH=/data/trackflow_users.json

# Local browser origins; container-to-container calls use http://backend:8000.
BACKOFFICE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001