{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://trackflow.example/schemas/telemetry-event-1.0.0.json",
    "title": "TrackFlow Telemetry Event",
    "description": "Closed event contract for the TrackFlow HITO 15 telemetry plan. Definitions and delivery decisions are aligned with docs/telemetry/telemetry-plan.md.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "schemaVersion",
        "requestId",
        "properties"
    ],
    "properties": {
        "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique event ID; stable across retries of the same business operation."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp, generated by the authoritative source."
        },
        "sessionId": {
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "description": "Opaque session identifier, never a cookie or bearer token; null when no session exists."
        },
        "userId": {
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "description": "Opaque pseudonymous internal actor ID; never email, name, or token; null when unauthenticated."
        },
        "event_type": {
            "type": "string",
            "enum": [
                "inbound_order_created",
                "outbound_order_created",
                "stock_threshold_triggered",
                "direct_stock_edit_rejected",
                "inventory_discrepancy_detected",
                "inventory_validation_failed",
                "inbound_order_cancelled",
                "auth_login_failed",
                "auth_login_succeeded",
                "session_expired",
                "api_latency_recorded",
                "api_error_recorded",
                "frontend_page_load_recorded",
                "frontend_error_captured",
                "backoffice_page_viewed",
                "inventory_flow_abandoned"
            ]
        },
        "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
        },
        "requestId": {
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "description": "Opaque request correlation ID; null if there is no associated request."
        },
        "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "warehouse": {
                    "type": "string"
                },
                "client_id": {
                    "type": "string"
                },
                "product_id": {
                    "type": "string"
                },
                "product_category": {
                    "type": "string"
                },
                "quantity": {
                    "type": "integer"
                },
                "order_id": {
                    "type": "string"
                },
                "threshold_quantity": {
                    "type": "integer"
                },
                "rejection_code": {
                    "type": "string"
                },
                "discrepancy_direction": {
                    "type": "string"
                },
                "audit_id": {
                    "type": "string"
                },
                "order_type": {
                    "type": "string"
                },
                "validation_code": {
                    "type": "string"
                },
                "cancellation_code": {
                    "type": "string"
                },
                "failure_reason": {
                    "type": "string"
                },
                "client_version": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "expiration_reason": {
                    "type": "string"
                },
                "route": {
                    "type": "string"
                },
                "method": {
                    "type": "string"
                },
                "status_code": {
                    "type": "integer"
                },
                "duration_ms": {
                    "type": "number"
                },
                "navigation_type": {
                    "type": "string"
                },
                "error_code": {
                    "type": "string"
                },
                "error_class": {
                    "type": "string"
                },
                "error_fingerprint": {
                    "type": "string"
                },
                "view": {
                    "type": "string"
                },
                "severity": {
                    "type": "string"
                },
                "flow_id": {
                    "type": "string"
                },
                "last_stage": {
                    "type": "string"
                }
            },
            "description": "Outer allowlist of known keys; the conditional schema selected by event_type further restricts each event to its own closed allowlist."
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "inbound_order_created"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/inbound_order_created"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "outbound_order_created"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/outbound_order_created"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "stock_threshold_triggered"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/stock_threshold_triggered"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "direct_stock_edit_rejected"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/direct_stock_edit_rejected"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "inventory_discrepancy_detected"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/inventory_discrepancy_detected"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "inventory_validation_failed"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/inventory_validation_failed"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "inbound_order_cancelled"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/inbound_order_cancelled"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "auth_login_failed"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/auth_login_failed"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "auth_login_succeeded"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/auth_login_succeeded"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "session_expired"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/session_expired"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "api_latency_recorded"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/api_latency_recorded"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "api_error_recorded"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/api_error_recorded"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "frontend_page_load_recorded"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/frontend_page_load_recorded"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "frontend_error_captured"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/frontend_error_captured"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "backoffice_page_viewed"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/backoffice_page_viewed"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "inventory_flow_abandoned"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "properties": {
                        "$ref": "#/definitions/inventory_flow_abandoned"
                    }
                }
            }
        }
    ],
    "definitions": {
        "warehouse": {
            "type": "string",
            "enum": [
                "los_angeles",
                "zaragoza"
            ]
        },
        "product_category": {
            "type": "string",
            "enum": [
                "moda",
                "electrónica",
                "cosmética"
            ]
        },
        "inventory_base": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Affected units; meaning is event-specific and documented in the plan."
                }
            }
        },
        "inbound_order_created": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity",
                "order_id"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Received units."
                },
                "order_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Opaque inbound order ID for deduplication."
                }
            },
            "x-event": {
                "classification": "mandatory",
                "category": "inventory",
                "description": "Inbound receipt is committed.",
                "hypothesis": "Measure received volume by client and warehouse.",
                "decision": "Plan warehouse capacity and staffing.",
                "delivery": "stream",
                "privacy": "Pseudonymous business identifiers only; no recipient or carrier data."
            }
        },
        "outbound_order_created": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity",
                "order_id"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Dispatched units."
                },
                "order_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Opaque outbound order ID for deduplication."
                }
            },
            "x-event": {
                "classification": "mandatory",
                "category": "inventory",
                "description": "Picking and dispatch completion are confirmed.",
                "hypothesis": "Measure outbound volume and processing pace by client and warehouse.",
                "decision": "Detect bottlenecks and SLA risk during operations.",
                "delivery": "stream",
                "privacy": "Pseudonymous business identifiers only; no recipient or carrier data."
            }
        },
        "stock_threshold_triggered": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity",
                "threshold_quantity"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Resulting on-hand stock at the downward threshold crossing."
                },
                "threshold_quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Configured minimum stock at the crossing."
                }
            },
            "x-event": {
                "classification": "mandatory",
                "category": "inventory",
                "description": "Stock crosses from at/above the configured minimum to below it.",
                "hypothesis": "Measure low-stock risk frequency for each client SKU.",
                "decision": "Alert the client and commercial team before a stockout.",
                "delivery": "stream",
                "privacy": "Pseudonymous business identifiers only; no recipient or carrier data.",
                "deduplication": "Emit once per downward crossing; re-arm only after stock recovers to threshold."
            }
        },
        "direct_stock_edit_rejected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity",
                "rejection_code"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Units the rejected direct edit attempted to change."
                },
                "rejection_code": {
                    "type": "string",
                    "enum": [
                        "order_required",
                        "permission_denied",
                        "unsupported_operation"
                    ],
                    "description": "Allowlisted rejection reason."
                }
            },
            "x-event": {
                "classification": "mandatory",
                "category": "inventory_control",
                "description": "A direct stock mutation outside an order is rejected.",
                "hypothesis": "Identify attempts to bypass stock traceability.",
                "decision": "Reinforce training or adjust warehouse permissions.",
                "delivery": "stream",
                "privacy": "Actor is represented only by pseudonymous userId; no free-form request data."
            }
        },
        "inventory_discrepancy_detected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity",
                "discrepancy_direction",
                "audit_id"
            ],
            "properties": {
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable opaque ID of the B2B brand that owns the SKU."
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable SKU/product identifier; one product_id belongs to exactly one client."
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Absolute magnitude of the system-vs-physical difference."
                },
                "discrepancy_direction": {
                    "type": "string",
                    "enum": [
                        "system_higher",
                        "physical_higher"
                    ],
                    "description": "Direction of the difference."
                },
                "audit_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Opaque physical count/audit ID."
                }
            },
            "x-event": {
                "classification": "mandatory",
                "category": "inventory",
                "description": "Physical count or audit confirms stock differs from system stock.",
                "hypothesis": "Locate SKUs and warehouses with frequent discrepancies.",
                "decision": "Prioritize inventory audits and corrective work.",
                "delivery": "stream",
                "privacy": "Pseudonymous business identifiers only; no recipient or carrier data."
            }
        },
        "inventory_validation_failed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "order_type",
                "validation_code",
                "warehouse",
                "client_id",
                "product_id",
                "product_category",
                "quantity"
            ],
            "properties": {
                "order_type": {
                    "type": "string",
                    "enum": [
                        "inbound",
                        "outbound"
                    ]
                },
                "validation_code": {
                    "type": "string",
                    "enum": [
                        "insufficient_stock",
                        "invalid_quantity",
                        "unknown_sku",
                        "warehouse_mismatch",
                        "missing_required_field",
                        "invalid_state"
                    ]
                },
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Requested units in the rejected order."
                }
            },
            "x-event": {
                "classification": "opportunity",
                "category": "inventory",
                "description": "An inventory order is rejected by a validation rule.",
                "hypothesis": "Identify recurring validation friction by rule and product.",
                "decision": "Improve UI guidance, training, or business validation.",
                "delivery": "batch",
                "privacy": "No request body or free-form validation message is captured."
            }
        },
        "inbound_order_cancelled": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "order_id",
                "client_id",
                "warehouse",
                "product_id",
                "product_category",
                "quantity",
                "cancellation_code"
            ],
            "properties": {
                "order_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Opaque inbound order ID."
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1
                },
                "warehouse": {
                    "$ref": "#/definitions/warehouse"
                },
                "product_id": {
                    "type": "string",
                    "minLength": 1
                },
                "product_category": {
                    "$ref": "#/definitions/product_category"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Planned units on the cancelled inbound order."
                },
                "cancellation_code": {
                    "type": "string",
                    "enum": [
                        "duplicate",
                        "supplier_delay",
                        "capacity_change",
                        "operator_cancelled",
                        "other"
                    ]
                }
            },
            "x-event": {
                "classification": "opportunity",
                "category": "inventory",
                "description": "An inbound order is cancelled before receipt confirmation.",
                "hypothesis": "Understand cancellation trends by client and warehouse.",
                "decision": "Adjust receiving plans and clarify cancellation workflow.",
                "delivery": "batch",
                "privacy": "No free-text cancellation notes are collected."
            }
        },
        "auth_login_failed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "failure_reason",
                "client_version"
            ],
            "properties": {
                "failure_reason": {
                    "type": "string",
                    "enum": [
                        "invalid_credentials",
                        "invalid_token",
                        "forbidden",
                        "server_error",
                        "account_disabled",
                        "rate_limited",
                        "unknown"
                    ]
                },
                "client_version": {
                    "type": "string",
                    "maxLength": 40
                }
            },
            "x-event": {
                "classification": "opportunity",
                "category": "authentication",
                "description": "A login attempt is rejected.",
                "hypothesis": "Measure authentication friction and suspicious failure patterns.",
                "decision": "Improve sign-in support or security controls.",
                "delivery": "stream",
                "privacy": "Never collect username, email, password, IP address, or submitted form values."
            }
        },
        "auth_login_succeeded": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "client_version"
            ],
            "properties": {
                "role": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "admin",
                        "manager",
                        "user"
                    ]
                },
                "warehouse": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/warehouse"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "client_version": {
                    "type": "string",
                    "maxLength": 40
                }
            },
            "x-event": {
                "classification": "opportunity",
                "category": "authentication",
                "description": "Authentication succeeds and a session is established.",
                "hypothesis": "Understand access patterns by role and operating site.",
                "decision": "Plan support and review unusual access patterns.",
                "delivery": "batch",
                "privacy": "Actor is pseudonymous in userId; no direct identity fields."
            }
        },
        "session_expired": {
            "type": "object",
